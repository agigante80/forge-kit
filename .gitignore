# Temporary scratch folder (contents ignored, folder kept)
temp/*
!temp/.gitkeep

# working-overnight runtime artifacts (manifest, queue, decisions, report)
.claude/overnight/

# Python bytecode (e.g. from py_compile-ing the hooks)
__pycache__/
*.pyc

# Private journal (local thinking notes, never committed)
.private-journal/
# --- AI assistant files (local only, never published) ---
# Anchored entries (/NAME) are root-only on purpose: a nested AGENTS.md or
# CLAUDE.md can belong to the project's own content and must stay tracked.
.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
.gemini/
.codex/
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurf/
.windsurfrules
.clinerules
.roo/
.roomodes
.devin/
.specstory/
.github/copilot-instructions.md
