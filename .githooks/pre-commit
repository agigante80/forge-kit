#!/usr/bin/env bash
# forge-kit pre-commit: enforce version-marker discipline on components.
#
# A component whose body changes must bump its `<name>-version` marker so forge-adapt's
# drift detection stays honest. New components must ship a marker. For a genuinely trivial
# edit (comment typo, whitespace) bypass with:  git commit --no-verify
#
# Enable once per clone:  git config core.hooksPath .githooks
set -uo pipefail

# Read a component's OWN version number from stdin. Ignores body references to
# `template-version` (issue-template marker, unrelated to component versioning).
ver_of() {
  grep -oP '[a-z0-9-]+-version: \d+' | grep -v '^template-version' | head -1 | grep -oP ': \K\d+'
}

# Early exit via pathspec, deliberately NOT a `printf | grep -q` pipe: grep -q closes the
# pipe at the first match, printf takes SIGPIPE (141), and under pipefail `|| exit 0` would
# then fire on a huge staged list even though plugins/ WAS touched (a verified fail-open).
# The pathspec form also keeps the diff-scope knowledge in one place: the guard script.
if git diff --cached --quiet -- plugins/; then exit 0; fi   # nothing under plugins/: done

# Marker discipline applies to added/modified component files only (a deletion has no
# marker to bump; the plugin-semver check below is what a deletion must satisfy).
files=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^plugins/[^/]+/(agents|commands)/[^/]+\.md$|^plugins/[^/]+/skills/[^/]+/SKILL\.md$|^plugins/[^/]+/hooks/[^/]+\.(py|sh)$|^plugins/[^/]+/skills/[^/]+/assets/[^/]+\.sh$' || true)

violations=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  staged_ver=$(git show ":$f" 2>/dev/null | ver_of)
  if git cat-file -e "HEAD:$f" 2>/dev/null; then
    head_ver=$(git show "HEAD:$f" 2>/dev/null | ver_of)
    if [ -z "$staged_ver" ]; then
      echo "  ✗ $f: version marker missing or removed (expected '<name>-version: N')"
      violations=$((violations + 1))
    elif [ "$staged_ver" = "$head_ver" ]; then
      echo "  ✗ $f: changed but still v$staged_ver (bump the <name>-version marker)"
      violations=$((violations + 1))
    fi
  else
    if [ -z "$staged_ver" ]; then
      echo "  ✗ $f: new component without a version marker (add '<name>-version: 1')"
      violations=$((violations + 1))
    fi
  fi
done <<< "$files"

# Plugin-GROUP semver (issue #79): ONE implementation shared with CI, the guard script's
# --staged mode (the PR #82 review found the previous hand-copied loop diverging from the
# CI script on day one: jq fail-open, opposite deleted-group handling, a different semver
# comparator). The script needs jq; a jq-less machine skips LOUDLY, never silently, and CI
# still enforces the same rule server-side.
guard="$(git rev-parse --show-toplevel)/scripts/check-plugin-version-bump.sh"
if [ -f "$guard" ]; then
  if command -v jq >/dev/null 2>&1; then
    if ! bash "$guard" --staged; then
      violations=$((violations + 1))
    fi
  else
    echo "  ! plugin-semver check SKIPPED locally: jq is not installed (CI enforces it)" >&2
  fi
fi

# Leak guard (issue #99), STAGED scan: the cheap half of the pair, asking "am I about to write
# down something from my own machine". The full-tree question is the pre-push hook's, because it
# is the one that matters when a history rewrite is needed.
#
# The private half is here and NOT in CI, and that is permanent rather than a gap: it needs the
# list of private names, and a list of the names you are hiding cannot live in the repository it
# protects, nor in a CI secret. It exits 0 with an explanation on a machine that has no list.
leaks=0
lg="$(git rev-parse --show-toplevel)/plugins/forge-kit-security/skills/leak-guard/assets"
# A project that has not written an allow-file yet must still be scanned. Passing a path that does
# not exist makes the scanner refuse the run, and the hook would read that refusal as a leak.
allow_args=()
[ -f "$(git rev-parse --show-toplevel)/.leak-guard-allow" ] \
  && allow_args=(--allow-file "$(git rev-parse --show-toplevel)/.leak-guard-allow")
[ -x "$lg/check-public-leaks.sh" ] && { bash "$lg/check-public-leaks.sh" --staged ${allow_args+"${allow_args[@]}"} || leaks=$((leaks + 1)); }
[ -x "$lg/check-private-leaks.sh" ] && { bash "$lg/check-private-leaks.sh" --staged || leaks=$((leaks + 1)); }

if [ "$leaks" -gt 0 ]; then
  echo ""
  echo "forge-kit: staged content carries something from this machine (see above)."
  echo "A private-name hit prints a redacted name; re-run with --show-names to see it in full."
  echo "Fix it, or for a false positive add an entry to .leak-guard-allow (public half only)."
  exit 1
fi

if [ "$violations" -gt 0 ]; then
  echo ""
  echo "forge-kit: $violations change(s) need a version bump (component marker or plugin.json)."
  echo "Bump it, or for a trivial edit re-run with: git commit --no-verify"
  exit 1
fi
exit 0
