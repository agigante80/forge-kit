#!/usr/bin/env bash
# forge-kit pre-push: run the RANGE guards here, where the range exists.
#
# WHY A SECOND STAGE (issue #98, item 3). `.githooks/pre-commit` checks the STAGED set, which is
# the right scope for fast feedback but the wrong scope for the real rule: "did this branch bump
# what it changed, compared to main". That question only has an answer once you know what you are
# pushing. Running it at commit time either asks a narrower question or pays for a range diff on
# every commit.
#
# It gives an early answer BEFORE the push; it is not a preview of CI's verdict. Both range guards
# also run in CI, on `pull_request` AND on pushes to main and develop (#158), and CI compares
# against a different base from this hook: the PR's target branch on a pull request, the pushed
# branch's previous tip on a push (scripts/resolve-range-base.sh). The two overlap without being
# the same check, so an answer here can differ from CI's. A push to any other branch gets no
# push-time CI run, though an open PR for it still triggers one.
#
# Option (a) from the ticket: a committed hook, no framework. Adopting `pre-commit` (the tool)
# would give a one-command two-stage install and would be the first package-manager dependency in
# a repo that deliberately has none. The stage split was worth stealing; the framework was not.
#
# Enabled by the same one-time step as pre-commit:  git config core.hooksPath .githooks
# Bypass for a genuinely trivial push:              git push --no-verify
set -uo pipefail

remote="${1:-origin}"
ROOT="$(git rev-parse --show-toplevel)"
# A hand run with GIT_DIR exported and no work tree (#401): git then takes the CURRENT directory as
# the root, so from `sub/` ROOT is `sub/` and every scan below sees a subtree, or finds no scanner
# at "$ROOT/plugins/..." and skips it on purpose. Refuse unless git, ignoring GIT_DIR, finds the
# same root. That predicate, not "GIT_WORK_TREE and core.worktree both unset", is deliberate: a
# `git push` from a linked worktree exports GIT_DIR=<repo>/.git/worktrees/<name> with neither set,
# and its root is still right, so the narrower test would refuse every such push.
if [ -n "${GIT_DIR+x}" ]; then
  root_="$(unset GIT_DIR; git rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$root_" ] && [ "$root_" = "$ROOT" ] || {
    echo "forge-kit: GIT_DIR is exported but names no work tree here (set GIT_WORK_TREE or core.worktree, or unset GIT_DIR); the leak guard could not RUN"
    exit 1
  }
fi
# Change to the root before every directory-relative step: the allow-file probe, both `--head`
# scans, the roadmap guard (`check-phases.sh` reads docs/roadmap.md from the working directory)
# and the suite-count pathspec. Git already runs a pre-push hook from the work-tree root, so this
# only makes a hand run from a subdirectory behave the same (#396). It fails closed: from `.git`
# `rev-parse --show-toplevel` fails, ROOT is empty, and a bare `cd "$ROOT"` would return 0 without
# moving and leave the guard silently skipped.
[ -n "$ROOT" ] && CDPATH= cd -- "$ROOT" || { echo "forge-kit: could not change to the work-tree root; the leak guard could not RUN"; exit 1; }
ZERO='0000000000000000000000000000000000000000'

# The guards resolve paths against HEAD (`git show "HEAD:$f"`), so they are only meaningful for
# the ref that IS the current checkout. Pushing some other branch gets a loud skip rather than a
# confident wrong answer.
head_sha="$(git rev-parse HEAD 2>/dev/null || echo none)"
relevant=0
push_base=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion: nothing to audit
  if [ "$local_sha" = "$head_sha" ]; then
    relevant=1
    push_base="$remote_sha"   # the remote's current tip for this ref: the range, with no fetch (#218)
  else
    echo "  ! pre-push: skipping ${local_ref:-?} (not the checked-out HEAD; the range guards read HEAD)" >&2
  fi
done
[ "$relevant" -eq 1 ] || exit 0

# ---------------------------------------------------------------------------------------------
# LEAK GUARD, before the base-ref exit, because it depends on none of it.
#
# It DOES sit after the "is this HEAD" test above, and that is deliberate rather than an oversight
# of the same kind: the scan reads HEAD's committed tree (`--head`), so running it while pushing
# some OTHER branch would report confidently on content that is not being pushed. Scanning the
# wrong tree is worse than not scanning.
#
# It used to sit further down, after the "is this HEAD" test and after the missing-base-ref exit.
# Neither is a precondition for a FULL-TREE scan, so on a clone that had not fetched origin/main
# both scanners were silently skipped, and the private half runs nowhere else at all. Found by
# review, not by the guard.
#
# The FULL-TREE scan of HEAD's tree is the right question here, not the range. A range scan asks
# "did this push add a leak", which is the wrong question the moment a history rewrite is needed:
# what matters then is whether the tree is clean, not whether this push made it worse.
#
# Its counter is its own. Sharing the range guards' counter reported a leak as "1 range check(s)
# failed ... this is what CI will run on the PR" and offered --no-verify, which is wrong three
# times over and recommends the worst possible response to a leak.
#
# The leak message is CONDITIONAL on purpose, because `leaks` is ONE counter shared by both
# scanners: the hook cannot tell which one fired. The public scan is repeated by CI, but only on
# pull requests and pushes to main and develop and only after publication; the private-name scan
# runs nowhere else. Do not collapse this back to one static claim either way (#313).
#
# WHAT IS SCANNED (#375): HEAD's committed tree, never the working tree. The pushed tip is HEAD
# (the loop above skips every other ref), so `--head` judges what a push publishes: a leak committed
# at HEAD and edited out only in an uncommitted change still blocks, and so does a tracked file
# deleted only in the working tree. The consequence is deliberate and not a regression: a leak that
# exists ONLY in an uncommitted edit no longer blocks, because it is never published and the next
# commit is caught by pre-commit (`--staged`). It is HEAD's tree, not every pushed commit: a leak
# added and removed inside one push is published and invisible to a tree scan.
# `.leak-guard-allow` is read from HEAD for the same reason: a `skip` entry drops a whole file, so
# an uncommitted entry would mask a committed leak exactly as an uncommitted edit does. A read
# failure is a could-not-RUN, never a fallback to the working-tree copy.
#
# THE ALLOW-FILE PROBE IS A MODE CHECK (#384). `git ls-tree --full-tree HEAD -- .leak-guard-allow`
# tells three things apart that `git cat-file -e` collapsed into one exit 128: empty output is
# ABSENT (no allow-file), a non-zero exit is a git failure (could-not-RUN), and a line is a tree
# entry whose MODE decides what happens. Only 100644 and 100755 are read. Any other mode is refused
# as could-not-RUN, and that is a decision, not a guess: a committed symlink (120000) reads back as
# its LINK TEXT, so a link whose text is itself a valid entry (`skip docs-leak.md`) was applied as
# a skip and the scan exited 0 over a committed leak. That failed OPEN. The key is the MODE field,
# never the type field, because a symlink lists as `120000 blob`. The read is `git cat-file blob`
# on the oid from that same line, so the object read is the object whose mode was checked. So no
# link shape is ever read here; do not describe this as "fails closed for every link shape" (an
# entry such as a link whose text is not a valid entry would have exited 2 only by accident).
# CI differs: it runs `--allow-file .leak-guard-allow` on the worktree, where `[ -f ]` follows a
# link, so a deliberately symlinked allow-file is refused here and followed there. `--full-tree`
# is defence in depth with no test of its own (#396): the `cd` to the root above already makes
# the probe root-relative, and the flag keeps it so if that `cd` is ever removed.
#
# "Once it is published", never "this push has published it" (#368): the hook cannot tell whether
# HEAD is already on the remote, and the public CI scan runs only after publication, so a leak
# blocks only once it is published; the --no-verify line says "can publish" because a push can
# publish what a tree scan of HEAD finds. Declined on purpose (#368):
# "when the run reaches that step" (an earlier red step already reddens the run, and the clause
# would couple this text to validate.yml's step order) and the scanner labels home-path,
# home-root, email (the findings above the message already print them, and pinning them fails
# this suite on a scanner rename).
lg="$ROOT/plugins/forge-kit-security/skills/leak-guard/assets"
allow_args=()
allow_tmp=""
# A plain EXIT trap: this hook set none before (#375), so there is nothing to compose with.
trap '[ -z "$allow_tmp" ] || rm -f "$allow_tmp"' EXIT

leaks=0
leak_errors=0
# The allow-file comes from HEAD's tree, not the working tree (#375, D2). Absent at HEAD means no
# allow-file, even when one sits in the working tree. The temp name says where it came from, so a
# scanner error on a malformed committed entry names a path that reads as the HEAD copy. The probe
# is explained in the paragraph above (#384).
if ! al_line="$(git ls-tree --full-tree HEAD -- .leak-guard-allow 2>/dev/null)"; then
  echo "forge-kit: could not read .leak-guard-allow at HEAD"
  leak_errors=$((leak_errors + 1))
elif [ -n "$al_line" ]; then
  read -r al_mode _ al_oid _ <<< "$al_line"
  case "$al_mode" in
    100644|100755)
      if allow_tmp="$(mktemp "${TMPDIR:-/tmp}/leak-guard-allow.HEAD.XXXXXX" 2>/dev/null)" \
         && git cat-file blob "$al_oid" > "$allow_tmp" 2>/dev/null; then
        allow_args=(--allow-file "$allow_tmp")
      else
        echo "forge-kit: could not read .leak-guard-allow at HEAD"
        leak_errors=$((leak_errors + 1))
      fi ;;
    *)
      echo "forge-kit: .leak-guard-allow at HEAD is mode $al_mode, not a regular file;" \
           "refusing to read it"
      leak_errors=$((leak_errors + 1)) ;;
  esac
fi
# Item 6 of #384, recorded rather than changed. The `[ -f "$script" ] || return 0` below skips an
# ABSENT scanner on purpose: absent means the project has not adopted the guard, which needs no
# announcement. Under `--head` the scanner itself still runs from the WORKING TREE (only the files
# it scans come from HEAD), so an uncommitted edit to a scanner is what runs; that is accepted.
# The roadmap guard's `exit 1` further down precedes the leak summary, so a roadmap failure plus a
# leak prints the roadmap wording and not the leak wording while offering --no-verify: also
# pre-existing and accepted, since the leak finding itself still prints above it.
scan() {
  local script="$1"; shift
  # PRESENCE, not the exec bit: this invokes via `bash`, so the bit is not needed to run the
  # scanner, and gating on it meant a copy without it disabled the guard SILENTLY. That fails
  # open, the one direction a security guard must never fail. A tarball, a `cp` without -p or a
  # filesystem with no exec bit all produce it. An absent file is different and is not an error:
  # it means the project has not adopted the guard.
  [ -f "$script" ] || return 0
  bash "$script" "$@"
  case "$?" in
    0) ;;
    1) leaks=$((leaks + 1)) ;;
    *) leak_errors=$((leak_errors + 1)) ;;
  esac
}
scan "$lg/check-public-leaks.sh" --head ${allow_args+"${allow_args[@]}"}
# Local only, never in CI: it needs the list of private names, which cannot be published.
scan "$lg/check-private-leaks.sh" --head

# The roadmap guard, OFFLINE half only. A push must never depend on the host being reachable, and
# rule 2 (an open phase has a plan carrying a Fails if section) needs only the files. The host rules
# run from /phase, where failing to reach the forge is worth stopping for; CI runs only the guard's
# contract tests, never the guard itself.
#
# Opt-in by the presence of docs/roadmap.md: with none, the script exits 0 saying so, and a project
# that declines the optional planning group is unaffected. The guard has its OWN counter and
# message, below, and does not share the leak guard's. Sharing it reported a roadmap finding in
# the leak guard's words, which is the wrong-message defect round 2 of that guard's review was
# about, made once already and not again. Only its file-only rule repeats nowhere server-side; the
# host rules are the half /phase runs, as the paragraph above says.
phase_problems=0
cp_="$ROOT/plugins/forge-kit-roadmap/skills/roadmap-phases/assets/check-phases.sh"
if [ -f "$cp_" ]; then
  bash "$cp_" --offline || phase_problems=$((phase_problems + 1))
fi

if [ "$phase_problems" -gt 0 ]; then
  echo ""
  echo "forge-kit: the roadmap does not satisfy check-phases.sh (see above)."
  echo "Only the file-only rule runs here; the host rules run from /phase; CI runs only the guard's contract tests."
  echo "Fix the roadmap or the phase plan, or push anyway with: git push --no-verify"
  exit 1
fi

if [ "$leak_errors" -gt 0 ]; then
  echo ""
  echo "forge-kit: the leak guard could not RUN (see above). A config or environment error, not"
  echo "a finding. Nothing was checked; fix what it reported."
  exit 1
fi
if [ "$leaks" -gt 0 ]; then
  echo ""
  echo "forge-kit: the tree carries something from this machine (see above)."
  echo "A private-name finding comes from a scan that runs only on this machine: no CI run repeats it."
  echo "A home path, root or address finding comes from the public scan, which CI also runs on pull"
  echo "requests and on pushes to main and develop, but only once it is published."
  echo "A push to another branch with no pull request triggers no CI scan at all."
  echo "A private-name hit prints a redacted name; re-run that scanner with --show-names."
  echo "Pushing past this with --no-verify can publish it. A push is not undone by a later commit."
  exit 1
fi

# ---------------------------------------------------------------------------------------------
# LOCAL-DOC CLAIMS (#218), above the base-ref exit for the same reason the leak guard is: nothing
# here depends on that exit, and a rule below it is SILENTLY skipped on a clone that has not
# fetched, which is the defect recorded at the top of this file for the leak guard.
#
# WHY THIS RUNS NOWHERE ELSE. CLAUDE.md stopped being published on 2026-09-16, so the
# `scripts/test-X`, N tests claims it carries, and the plugin-groups region generated into it, are
# in no CI checkout. The CI step that checked the counts could no longer fail for any input and was
# deleted; this is where the question can still be asked, on the machine that has the file.
#
# WHY --changed. Every claim is checked by RUNNING its suite: 93 s, measured when there were twelve
# counted suites (there are more now), against a 0.035 s baseline for this whole hook. A rule that
# slow is one people push past, which is the failure this repo keeps naming. The range decides which suites run, so a push touching none of
# them costs 0.3 s. The range comes from this hook's own stdin (the remote tip captured above), not
# from origin/main, so it needs no fetch and survives the missing-base-ref path below.
#
# Exit 1 and exit 2 are told apart on purpose, the distinction the leak guard already draws: a
# stale claim and a suite that could not run send you to different places. A missing python3 skips
# loudly and never blocks, the posture the pre-commit hook takes for jq.
doc_problems=0
if command -v python3 >/dev/null 2>&1; then
  changed_files=""
  if [ -n "$push_base" ] && [ "$push_base" != "$ZERO" ] \
     && git rev-parse --verify --quiet "$push_base^{commit}" >/dev/null; then
    changed_files="$(git diff --name-only "$push_base" "$head_sha" -- 'scripts/test-*' 2>/dev/null || true)"
  else
    b_="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
    [ -n "$b_" ] || b_="$remote/main"
    if git rev-parse --verify --quiet "$b_^{commit}" >/dev/null; then
      changed_files="$(git diff --name-only "$b_" "$head_sha" -- 'scripts/test-*' 2>/dev/null || true)"
    else
      changed_files="__unknown__"
    fi
  fi
  cnt_="$ROOT/scripts/update-suite-counts.py"
  # WHY THESE TWO SKIPS ARE LOUD WHEN scan()'S AND THE VERSION-BUMP GUARD'S ARE NOT (#221). Those
  # are opt-in guards: an absent one means the project has not adopted them, which is a choice and
  # needs no announcement. These two generators are owned by THIS repository, so an absent one is a
  # checkout missing part of the kit, and the claims it owns go unchecked with nothing else to ask.
  # Do not "fix" scan() to match, and do not revert these to silence. Neither touches
  # doc_problems: a skip never blocks the push.
  if [ ! -f "$cnt_" ]; then
    echo "  ! pre-push: scripts/update-suite-counts.py is missing; the suite-count claims were NOT checked." >&2
  elif [ "$changed_files" = "__unknown__" ]; then
    echo "  ! pre-push: no range (neither the pushed ref's remote tip nor '$remote/main' is here);" >&2
    echo "  !           the suite-count claims were NOT checked. 'git fetch $remote' enables them." >&2
  else
    # Unquoted on purpose: the paths are git's own output, one per line, and the pathspec above
    # already confined them to scripts/test-*.
    # shellcheck disable=SC2086
    python3 "$cnt_" --check --changed $changed_files
    rc_=$?
    if [ "$rc_" -eq 1 ]; then
      doc_problems=$((doc_problems + 1))
    elif [ "$rc_" -ne 0 ]; then
      echo "  ! pre-push: the suite-count check could not RUN (exit $rc_), which is not a stale claim." >&2
      doc_problems=$((doc_problems + 1))
    fi
  fi
  idx_="$ROOT/scripts/update-component-index.py"
  if [ -f "$idx_" ]; then
    # The generator's report is NOT discarded (#311, L5). It names each stale region as
    # "<file> (<region id>)" on stdout, which is the only place that says WHICH one is stale, so
    # the old `>/dev/null` left the summary below pointing at "see above" with nothing above it.
    # This hook composes its own stderr line and quotes the generator's report under it. A
    # missing-marker SystemExit already goes to stderr and is left alone, so it stays visible. A
    # current index stays silent here: nothing is printed on success.
    idx_out_="$(python3 "$idx_" --check)"
    idx_rc_=$?
    if [ "$idx_rc_" -ne 0 ]; then
      doc_problems=$((doc_problems + 1))
      echo "  ! pre-push: update-component-index.py --check failed (exit $idx_rc_):" >&2
      printf '%s\n' "$idx_out_" | sed 's/^/  !   /' >&2
    fi
  else
    echo "  ! pre-push: scripts/update-component-index.py is missing; the generated regions were NOT checked." >&2
  fi
else
  echo "  ! pre-push: python3 not found; the local-doc claims were NOT checked (CI cannot check" >&2
  echo "  !           them either: the doc is in no checkout). Install python3 to enable them." >&2
fi

if [ "$doc_problems" -gt 0 ]; then
  echo ""
  echo "forge-kit: a generated claim in a LOCAL doc is stale or could not be checked (see above)."
  echo "Run: python3 scripts/update-suite-counts.py   and   python3 scripts/update-component-index.py"
  echo "Nothing server-side repeats this: CLAUDE.md is in no CI checkout."
  echo "A counted suite can also flake (#219); re-run before believing a count you did not change."
  exit 1
fi

# Compare against the remote's default branch (origin/HEAD, else origin/main). CI's base differs:
# at PR time it passes origin/$BASE_REF, the PR's target branch, which is this default branch only
# for a PR into it. Pushing the default branch itself makes this the server's current tip, so the
# audited range is exactly the commits being added, which is the path CI's PR trigger never sees.
base="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
[ -n "$base" ] || base="$remote/main"

if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
  # Loud skip, never silent, and never a blocked push: the same posture the pre-commit hook takes
  # for a missing jq.
  #
  # Between 2026-09-08 and #158 the range guards were `pull_request`-only and nothing server-side
  # checked them, so this message said so. Since #158 they also run on pushes to main and develop,
  # so it says that, without promising CI reaches the same verdict or runs for every branch.
  echo "  ! pre-push: base ref '$base' not found locally; range checks SKIPPED." >&2
  echo "  !           CI also runs both range guards (see #158): on pull requests against the PR's" >&2
  echo "  !           target branch, and on pushes to main and develop against the previous tip of" >&2
  echo "  !           the pushed branch. Its answer can differ from this hook's. A push to any other" >&2
  echo "  !           branch gets no push-time CI run, though an open PR for it still triggers one." >&2
  echo "  !           run 'git fetch $remote' to enable them locally." >&2
  exit 0
fi

violations=0
for guard in check-version-bump.sh check-plugin-version-bump.sh; do
  script="$ROOT/scripts/$guard"
  [ -f "$script" ] || continue
  if [ "$guard" = "check-plugin-version-bump.sh" ] && ! command -v jq >/dev/null 2>&1; then
    echo "  ! pre-push: plugin-semver check SKIPPED: jq is not installed (CI enforces it)." >&2
    continue
  fi
  bash "$script" "$base" || violations=$((violations + 1))
done

if [ "$violations" -gt 0 ]; then
  echo ""
  echo "forge-kit: $violations range check(s) failed against $base."
  echo "CI also runs both range guards, on pull requests and on pushes to main and develop (#158)."
  echo "On a pull request it compares against the PR's target branch, and on a push against the"
  echo "pushed branch's previous tip (the default branch for a new ref or a force push), so its"
  echo "answer can differ from this one against $base. A push to another branch triggers no"
  echo "push-time CI run, though an open PR for it still triggers one."
  echo "Fix it, or push anyway with: git push --no-verify"
  exit 1
fi
exit 0
