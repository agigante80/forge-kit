#!/usr/bin/env bash
# forge-kit pre-push: run the RANGE guards here, where the range exists.
#
# WHY A SECOND STAGE (issue #98, item 3). `.githooks/pre-commit` checks the STAGED set, which is
# the right scope for fast feedback but the wrong scope for the real rule: "did this branch bump
# what it changed, compared to main". That question only has an answer once you know what you are
# pushing. Running it at commit time either asks a narrower question or pays for a range diff on
# every commit.
#
# It is also the only local gate on one path. Both range guards run in CI on `pull_request` ONLY,
# so a direct push to main is otherwise checked by nothing.
#
# Option (a) from the ticket: a committed hook, no framework. Adopting `pre-commit` (the tool)
# would give a one-command two-stage install and would be the first package-manager dependency in
# a repo that deliberately has none. The stage split was worth stealing; the framework was not.
#
# Enabled by the same one-time step as pre-commit:  git config core.hooksPath .githooks
# Bypass for a genuinely trivial push:              git push --no-verify
set -uo pipefail

remote="${1:-origin}"
ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'

# The guards resolve paths against HEAD (`git show "HEAD:$f"`), so they are only meaningful for
# the ref that IS the current checkout. Pushing some other branch gets a loud skip rather than a
# confident wrong answer.
head_sha="$(git rev-parse HEAD 2>/dev/null || echo none)"
relevant=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion: nothing to audit
  if [ "$local_sha" = "$head_sha" ]; then
    relevant=1
  else
    echo "  ! pre-push: skipping ${local_ref:-?} (not the checked-out HEAD; the range guards read HEAD)" >&2
  fi
done
[ "$relevant" -eq 1 ] || exit 0

# ---------------------------------------------------------------------------------------------
# LEAK GUARD, before the base-ref exit, because it depends on none of it.
#
# It DOES sit after the "is this HEAD" test above, and that is deliberate rather than an oversight
# of the same kind: a full-tree scan reads the checked-out worktree, so running it while pushing
# some OTHER branch would report confidently on content that is not being pushed. Scanning the
# wrong tree is worse than not scanning.
#
# It used to sit further down, after the "is this HEAD" test and after the missing-base-ref exit.
# Neither is a precondition for a FULL-TREE scan, so on a clone that had not fetched origin/main
# both scanners were silently skipped, and the private half runs nowhere else at all. Found by
# review, not by the guard.
#
# The FULL-TREE scan is the right question here, not the range. A range scan asks "did this push
# add a leak", which is the wrong question the moment a history rewrite is needed: what matters
# then is whether the tree is clean, not whether this push made it worse.
#
# Its counter is its own. Sharing the range guards' counter reported a leak as "1 range check(s)
# failed ... this is what CI will run on the PR" and offered --no-verify, which is wrong three
# times over and recommends the worst possible response to a leak.
lg="$ROOT/plugins/forge-kit-security/skills/leak-guard/assets"
allow_args=()
[ -f "$ROOT/.leak-guard-allow" ] && allow_args=(--allow-file "$ROOT/.leak-guard-allow")

leaks=0
leak_errors=0
scan() {
  local script="$1"; shift
  # PRESENCE, not the exec bit: this invokes via `bash`, so the bit is not needed to run the
  # scanner, and gating on it meant a copy without it disabled the guard SILENTLY. That fails
  # open, the one direction a security guard must never fail. A tarball, a `cp` without -p or a
  # filesystem with no exec bit all produce it. An absent file is different and is not an error:
  # it means the project has not adopted the guard.
  [ -f "$script" ] || return 0
  bash "$script" "$@"
  case "$?" in
    0) ;;
    1) leaks=$((leaks + 1)) ;;
    *) leak_errors=$((leak_errors + 1)) ;;
  esac
}
scan "$lg/check-public-leaks.sh" --all ${allow_args+"${allow_args[@]}"}
# Local only, never in CI: it needs the list of private names, which cannot be published.
scan "$lg/check-private-leaks.sh" --all

if [ "$leak_errors" -gt 0 ]; then
  echo ""
  echo "forge-kit: the leak guard could not RUN (see above). A config or environment error, not"
  echo "a finding. Nothing was checked; fix what it reported."
  exit 1
fi
if [ "$leaks" -gt 0 ]; then
  echo ""
  echo "forge-kit: the tree carries something from this machine (see above)."
  echo "This is NOT one of the CI checks; nothing server-side will catch it for you."
  echo "A private-name hit prints a redacted name; re-run that scanner with --show-names."
  echo "Pushing past this with --no-verify publishes it. A push is not undone by a later commit."
  exit 1
fi

# Compare against the remote's default branch, which is what CI passes at PR time
# (origin/$BASE_REF). Pushing the default branch itself makes this the server's current tip, so
# the audited range is exactly the commits being added, which is the path CI never sees.
base="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
[ -n "$base" ] || base="$remote/main"

if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
  # Loud skip, never silent, and never a blocked push: the same posture the pre-commit hook takes
  # for a missing jq.
  #
  # It used to add "CI still enforces", which stopped being true on 2026-09-08: both range guards
  # are `pull_request`-only and work now lands on develop with no pull requests, so NOTHING
  # server-side checks them. Saying otherwise is the same wrong-message defect this hook's leak
  # half was fixed for. #158 restores the server-side half.
  echo "  ! pre-push: base ref '$base' not found locally; range checks SKIPPED." >&2
  echo "  !           NOTHING else checks them: both range guards are pull_request-only and this" >&2
  echo "  !           repo no longer uses pull requests (see #158)." >&2
  echo "  !           run 'git fetch $remote' to enable them locally." >&2
  exit 0
fi

violations=0
for guard in check-version-bump.sh check-plugin-version-bump.sh; do
  script="$ROOT/scripts/$guard"
  [ -f "$script" ] || continue
  if [ "$guard" = "check-plugin-version-bump.sh" ] && ! command -v jq >/dev/null 2>&1; then
    echo "  ! pre-push: plugin-semver check SKIPPED: jq is not installed (CI enforces it)." >&2
    continue
  fi
  bash "$script" "$base" || violations=$((violations + 1))
done

if [ "$violations" -gt 0 ]; then
  echo ""
  echo "forge-kit: $violations range check(s) failed against $base."
  echo "This is the LAST check on these: both range guards are pull_request-only and this repo"
  echo "no longer uses pull requests, so nothing server-side repeats it (see #158)."
  echo "Fix it, or push anyway with: git push --no-verify"
  exit 1
fi
exit 0
